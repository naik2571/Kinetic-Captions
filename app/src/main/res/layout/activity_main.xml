<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <!-- Top Header -->
    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="🎬 Kinetic Captions"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnImportVideo"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSubHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Synchronized Word-by-Word Viral Typography Studio"
        android:textColor="@color/accent_yellow"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnImportVideo"
        app:layout_constraintTop_toBottomOf="@+id/tvHeader" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnImportVideo"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📁 Import MP4"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/tvSubHeader" />

    <!-- Video & Canvas Viewport Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardViewport"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#000000"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/divider_color"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@+id/tvSubHeader">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <VideoView
                android:id="@+id/videoView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Built-in Procedural Canvas Viewport -->
            <com.media.kineticcaptions.KineticCaptionOverlay
                android:id="@+id/captionOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Timeline & Playback Controls -->
    <LinearLayout
        android:id="@+id/rowTimeline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/cardViewport">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlayPause"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="▶"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/seekBarTimeline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="8500"
            android:progress="0"
            android:progressTint="@color/accent_yellow"
            android:thumbTint="@color/accent_yellow" />

        <TextView
            android:id="@+id/tvTimecode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00 / 08:50"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Style Selector Chips -->
    <HorizontalScrollView
        android:id="@+id/scrollChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@+id/rowTimeline">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupStyles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPopBounce"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="🔥 Pop &amp; Bounce" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipKaraoke"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎤 Karaoke Pill" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTypewriter"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Typewriter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipNeonPulse"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ Neon Pulse" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Script Preset Controls -->
    <LinearLayout
        android:id="@+id/rowPresets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/scrollChips">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPresetHook"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="🎣 Viral Hook"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPresetTech"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="⚡ Tech Intro"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Captions Timeline Header -->
    <TextView
        android:id="@+id/tvTimelineHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="SYNCHRONIZED CAPTION BLOCKS"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rowPresets" />

    <!-- RecyclerView Segments -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCaptions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@+id/tvTimelineHeader"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
